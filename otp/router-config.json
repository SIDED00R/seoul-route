// OTP 는 설정 JSON 에 // 주석을 허용한다(OTP 2.10.0 ConfigFileLoader 실측 2026-09-12).
// 백엔드가 이 파일을 엄격 JSON 파서로 읽게 되면 주석을 걷어내야 한다.
{
  "routingDefaults": {
    // 1.2 m/s: placeholder. OTP 기본 1.35 에서 낮춘 값이며 실측값이 아니다.
    // Phase 3 속도 학습 데이터가 쌓이면 사용자별 값이 요청마다 덮어쓰고, 이 기본값은 전체 중앙값으로 재보정한다.
    "walk": { "speed": 1.2 },
    "bicycle": {
      // 3.5 m/s: placeholder. OTP 기본 5.0(평지 최대속도)에서 낮춘 값이며 실측값이 아니다. 재보정 규칙은 walk 와 같다.
      "speed": 3.5,
      "rental": {
        // pickupTime PT1M: OTP 2.10 기본값과 동일. dropOffTime PT1M: OTP 기본 30초에서 올렸으나 근거 미정,
        // Phase 1 따릉이 대여·반납 실측 후 확정한다.
        "pickupTime": "PT1M", "dropOffTime": "PT1M", "useAvailabilityInformation": true
      }
    },
    "numItineraries": 10
  },
  "updaters": [
    {
      "type": "vehicle-rental",
      "network": "ttareungi",
      "sourceType": "gbfs",
      "url": "http://localhost:8090/gbfs.json",
      "frequency": "1m"
    }
  ]
}
