// OTP 라우터 설정.
// 백엔드가 이 파일을 엄격 JSON 파서로 읽게 되면 주석을 걷어내야 한다.
// transferSlack 은 설정하지 않아 OTP 기본 2분이다. 백엔드 realtime.TransferSlackSec(120) 가 이 값을 가정하므로
// 여기서 바꾸면 그 상수도 같이 바꾼다(deploy/otp/router-config.json 도 같다).
{
  "routingDefaults": {
    // 1.23 m/s: 학습 사전값(이동 중 평균 1.2)을 route.WalkOTPSpeed 로 바꾼 값. 이 speed 는 평지 최대속도라
    // 평균을 그대로 넣으면 예상이 길어진다. speed_profiles 값이 있으면 백엔드가 요청마다 덮어쓴다.
    "walk": { "speed": 1.23 },
    "bicycle": {
      // 5.0 m/s: OTP 기본값. 이 값은 평지 최대속도이고 학습값은 GPS 평균이라, 백엔드가 요청마다
      // route.BikeOTPSpeed 로 바꿔 덮어쓴다. 최적화 기준·끌기 비용도 백엔드가 요청에 담는다(internal/otp/client.go).
      "speed": 5.0,
      "rental": {
        // pickupTime PT1M: OTP 2.10 기본값과 동일. dropOffTime PT1M: OTP 기본 30초에서 올렸으나 근거 미정,
        // 대여소 반환 비용.
        "pickupTime": "PT1M", "dropOffTime": "PT1M", "useAvailabilityInformation": true
      }
    },
    "numItineraries": 10
  },
  "updaters": [
    {
      "type": "vehicle-rental",
      "network": "ttareungi",
      "sourceType": "gbfs",
      // 백엔드 GBFS 어댑터(실제 따릉이). 스파이크 fixture 는 otp/fixtures/gbfs 를 8090 에 띄우고 이 URL 을 바꾼다.
      // Compose 에서는 deploy/otp/router-config.json(url 이 http://api:8081)을 쓴다. routingDefaults 를 고치면 그쪽도 맞춘다.
      "url": "http://localhost:8081/gbfs/gbfs.json",
      "frequency": "1m",
      // 따릉이는 만차여도 반납이 된다 → 빈 거치대 0 이어도 반납 허용.
      "overloadingAllowed": true
    }
  ]
}
