# 복사해서 .env 로 저장하고 값을 직접 채운다. .env 는 커밋되지 않는다.
# 값에 $가 있으면 Docker Compose 보간을 막도록 작은따옴표로 감싼다(예: KEY='value$part').

# 서울 열린데이터광장 일반 인증키 (따릉이 bikeList, 대여소 마스터)
SEOUL_OPENAPI_KEY=

# 서울 열린데이터광장 실시간 지하철 인증키 (선택, 첫 지하철 탑승 보정)
SEOUL_SUBWAY_REALTIME_KEY=

# 공공데이터포털 인증키 (서울 버스 도착정보와 GTFS 버스 데이터 수집)
DATA_GO_KR_KEY=

# 레일포털(data.kric.go.kr) Open API 인증키 — 코레일·신분당·공항철도 요일별 열차 시각표(역사별 운행시각표·노선정보·역사별 정보)
KRIC_API_KEY=

# 장소 검색·지도 타일 프록시
VWORLD_API_KEY=
KAKAO_REST_API_KEY=

# 백엔드
# Google Cloud 콘솔의 웹 OAuth 클라이언트 ID. Android 클라이언트는 앱 패키지명·서명 SHA-1로 별도 생성한다.
GOOGLE_OAUTH_CLIENT_ID=
# 이 서버에 Google 로그인할 수 있는 계정 이메일(쉼표 구분). 운영(.env)은 실제 개인 계정만, 개발(.env.dev)은 테스트 계정만.
# 비우면 모든 계정을 허용한다(기동 로그에 경고). 목록 밖 계정은 403 이고 사용자 행을 만들지 않는다.
AUTH_ALLOWED_EMAILS=
# ODsay Lab API 키(lab.odsay.com, 개인 무료 하루 30회). 경로 정확도 자동 대조(평가셋)용. 없으면 대조만 안 됨
ODSAY_API_KEY=
PORT=8081
# OTP 가 GBFS 를 읽어갈 이 서버 주소. 로컬은 비워두면 http://localhost:{PORT}, Compose 는 http://api:8081
PUBLIC_URL=
DATABASE_URL=postgres://seoul:seoul@localhost:5432/seoul_route?sslmode=disable
OTP_URL=http://localhost:8080
# 비우면 각각 otp/data/seoul-gtfs.zip, otp/data/crossings.csv를 사용한다.
GTFS_ZIP=
CROSSINGS_CSV=
# 32자 이상 임의 문자열. `python -c "import secrets;print(secrets.token_hex(32))"`. 값 뒤에 주석을 붙이면 주석까지 값으로 읽힌다.
JWT_SECRET=

# 백엔드 DB 통합 테스트용. 없으면 httpapi 통합 테스트가 skip된다. 개발 스택(deploy/compose.dev.yml)의 DB 는 호스트 5433.
TEST_DATABASE_URL=postgres://seoul:seoul@localhost:5432/seoul_route_test?sslmode=disable

# --- 개발 스택(.env.dev 에서만) ---
# 이 파일을 .env.dev 로 한 번 더 복사해 JWT_SECRET 을 다른 값으로, AUTH_ALLOWED_EMAILS 를 테스트 계정으로 바꾼다.
# 그래프·데이터 폴더(otp/). 비우면 레포의 ../otp. 다른 체크아웃의 그래프를 쓸 때만 절대경로로 준다.
OTP_DIR=
